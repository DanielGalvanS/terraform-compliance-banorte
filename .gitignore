# Node
node_modules
dist
*.local

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
# Los .tfvars y la configuración del backend llevan valores reales
# (project IDs, buckets); solo se versionan los ejemplos.
*.tfvars
!*.tfvars.example
*.tfbackend
!*.tfbackend.example
# El lock de proveedores SÍ se versiona: fija las versiones (convención del reto).
!.terraform.lock.hcl

# Credenciales: nunca deben entrar al repo
*.json.key
service-account*.json
.env
.env.*

# macOS
.DS_Store

# Python: los scripts traen pruebas, y ejecutarlas deja bytecode.
__pycache__/
*.pyc

# El lock de proveedores se versiona en environments/, no en módulos reutilizables.
infra/modules/**/.terraform.lock.hcl

# Salida de la compuerta de políticas: se genera en cada ejecución del pipeline.
veredicto.json
