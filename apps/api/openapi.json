                          "titulo",
                          "descripcion",
                          "severidad",
                          "mapeo"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "version",
                    "controles"
                  ],
                  "additionalProperties": false
