{
  "openapi": "3.0.3",
  "info": {
    "title": "Compliance Ops API",
    "description": "Lectura de la postura de cumplimiento y registro de hallazgos. El catálogo de controles se sirve desde infra/policies/mappings.yaml, el mismo archivo que evalúa la compuerta del pipeline.",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/salud": {
      "get": {
        "summary": "Comprobación de vida",
        "tags": [
          "operación"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "estado": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "catalogo": {
                      "type": "string",
                      "description": "Versión del catálogo cargado"
                    },
                    "persistencia": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "estado",
                    "catalogo",
                    "persistencia"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/marcos": {
      "get": {
        "summary": "Marcos regulatorios en alcance",
        "tags": [
          "catálogo"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "marcos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "clave": {
                            "type": "string",
                            "description": "Identificador interno, por ejemplo cis_gcp"
                          },
                          "nombre": {
                            "type": "string"
                          },
                          "nombreCorto": {
                            "type": "string",
                            "description": "El nombre que muestran las pantallas"
                          },
                          "version": {
                            "type": "string"
                          },
                          "ambito": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "clave",
                          "nombre",
                          "nombreCorto"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "version",
                    "marcos"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/controles": {
