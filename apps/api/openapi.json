                            "type": "string"
                          },
                          "titulo": {
                            "type": "string"
                          },
                          "recurso": {
                            "type": "string"
                          },
                          "severidad": {
                            "type": "string",
                            "enum": [
                              "Crítica",
                              "Alta",
                              "Media",
                              "Baja"
                            ]
                          },
                          "ambiente": {
                            "type": "string",
                            "enum": [
                              "Dev",
                              "QA",
                              "Prod"
                            ]
                          },
                          "origen": {
                            "type": "string",
                            "enum": [
                              "Plan",
                              "Drift",
                              "Evento",
                              "Auditoría"
                            ]
                          },
                          "estado": {
                            "type": "string",
                            "enum": [
                              "Abierto",
                              "En remediación",
                              "Excepción",
                              "Cerrado"
                            ]
                          },
                          "mensaje": {
                            "type": "string"
                          },
                          "detectadoEn": {
                            "type": "string",
                            "description": "Fecha ISO 8601"
                          },
                          "detalle": {
                            "type": "object",
                            "properties": {
                              "controlViolado": {
                                "type": "object",
                                "properties": {
                                  "codigo": {
                                    "type": "string"
                                  },
                                  "enunciado": {
                                    "type": "string"
                                  },
                                  "equivalentes": {
                                    "type": "array",
