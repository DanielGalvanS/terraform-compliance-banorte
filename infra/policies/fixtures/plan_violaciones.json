{
  "format_version": "1.2",
  "terraform_version": "1.16.4",
  "resource_changes": [
    {
      "address": "google_compute_firewall.allow_ssh",
      "type": "google_compute_firewall",
      "name": "allow_ssh",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "fw-allow-ssh",
          "direction": "INGRESS",
          "priority": 1000,
          "source_ranges": ["0.0.0.0/0"],
          "allow": [{ "protocol": "tcp", "ports": ["22"] }]
        }
      }
    },
    {
      "address": "google_compute_firewall.allow_all",
      "type": "google_compute_firewall",
      "name": "allow_all",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "fw-allow-all",
          "direction": "INGRESS",
          "priority": 1200,
          "source_ranges": ["0.0.0.0/0"],
          "allow": [{ "protocol": "all" }]
        }
      }
    },
    {
      "address": "google_sql_database_instance.publica",
